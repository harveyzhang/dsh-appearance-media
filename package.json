{
  "name": "dsh-appearance-media",
  "version": "0.1.0",
  "description": "Background, intro clip and screensaver for DeepSeek Harness, sharing one media library. · DSH 外观媒体插件：背景、片头与屏保三合一，共用一份素材库。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "icon.svg",
    "locale",
    "docs",
    "lib",
    "skills",
    "scripts",
    "src",
    "build-client.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harveyzhang/dsh-appearance-media.git"
  },
  "homepage": "https://github.com/harveyzhang/dsh-appearance-media",
  "bugs": {
    "url": "https://github.com/harveyzhang/dsh-appearance-media/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "appearance",
    "wallpaper",
    "boot",
    "screensaver",
    "media"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.0-rc.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
